# ==============================================================================
# WB-Profit-Engine — Zero-Trust Environment Template (.env.example)
# Copy to `.env` before running `docker compose up -d --build`
# NEVER commit `.env` containing real production secrets to Git.
# ==============================================================================

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Application & GitHub Container Registry Metadata
PROJECT_NAME="WB-Profit-Engine"
ENVIRONMENT="production"
GITHUB_REPOSITORY="your-github-username/wb-profit-engine"

# PostgreSQL 16 (Internal backend_net)
POSTGRES_USER="wb_admin"
POSTGRES_PASSWORD="REPLACE_WITH_32_CHAR_RANDOM_DB_PASSWORD"
POSTGRES_HOST="postgres-db"
POSTGRES_PORT=5432
POSTGRES_DB="wb_profit_db"

# Redis 7 Cache (Internal backend_net)
REDIS_HOST="redis-cache"
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=3600

# JWT Authentication (Generate via: openssl rand -hex 32)
JWT_SECRET_KEY="REPLACE_WITH_64_HEX_CHARACTER_CRYPTOGRAPHIC_SECRET"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Wildberries Calculation Engine Defaults
WB_DEFAULT_COMMISSION=0.19
WB_ACQUIRING_RATE=0.015
WB_DEFAULT_WAREHOUSE_COEFF=1.7
WB_RETURN_LOGISTICS_RUB=50.0
WB_DEFAULT_VOLUME_LITERS=2.0
